{
  "name": "writer-app",
  "version": "1.0.0",
  "description": "A minimal, beautiful writing app powered by Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply writer-app-db --local",
    "migrate:remote": "wrangler d1 migrations apply writer-app-db --remote",
    "db:create": "wrangler d1 create writer-app-db",
    "types": "wrangler types"
  },
  "keywords": ["writing", "cloudflare", "workers", "d1"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.100.0"
  }
}
